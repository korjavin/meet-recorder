# Copy to .env next to docker-compose.yml (or set these in the Portainer stack
# environment). Placeholders only — never commit real values.

# Required. HMAC-SHA256 key for requests and events; the orchestrator holds the
# same value. Generate one with: openssl rand -hex 32
RECORDER_SECRET=change-me

# Optional; the values below are the defaults.
PORT=8080
BOT_DISPLAY_NAME=NoteTaker
JOIN_TIMEOUT_S=1200
MAX_DURATION_S=14400
EMPTY_GRACE_S=60
LOG_LEVEL=info

# Compose only (not read by the service).
# Shared recordings volume, created once with `docker volume create recordings`.
RECORDINGS_VOLUME=recordings
# External Docker network shared with the orchestrator.
TRAEFIK_NETWORK_NAME=traefik

# DATA_DIR is fixed to /data/meet by docker-compose.yml.
